    "import cv2\n",
    "import numpy as np\n",
    "import time\n",
    "from tensorflow.keras.models import load_model\n",
    "\n",
    "model = load_model('Areca_image_classifier.h5')\n",
    "\n",
    "cap = cv2.VideoCapture(0)\n",
    "class_labels = ['RIPE', 'UNRIPE']\n",
    "\n",
    "last_prediction_time = time.time()\n",
    "prediction_interval = 2.0\n",
    "current_label = ''\n",
    "\n",
    "def preprocess(roi):\n",
    "    resized = cv2.resize(roi, (224, 224))\n",
    "    normalized = resized.astype(np.float32) / 255.0\n",
    "    return np.expand_dims(normalized, axis=0)\n",
    "\n",
    "while True:\n",
    "    ret, frame = cap.read()\n",
    "    if not ret:\n",
    "        continue\n",
    "\n",
    "    display_frame = frame.copy()\n",
    "    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)\n",
    "    blurred = cv2.GaussianBlur(gray, (5, 5), 0)\n",
    "    _, thresh = cv2.threshold(blurred, 60, 255, cv2.THRESH_BINARY_INV)\n",
    "\n",
    "    # Find contours\n",
    "    contours, _ = cv2.findContours(thresh, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n",
    "    \n",
    "    # Process largest contour (assuming it is the arecanut)\n",
    "    if contours:\n",
    "        largest_contour = max(contours, key=cv2.contourArea)\n",
    "        x, y, w, h = cv2.boundingRect(largest_contour)\n",
    "\n",
    "        # Draw bounding box\n",
    "        cv2.rectangle(display_frame, (x, y), (x + w, y + h), (255, 0, 0), 2)\n",
    "\n",
    "        # Classify every 2 seconds using this region\n",
    "        if time.time() - last_prediction_time > prediction_interval and w > 50 and h > 50:\n",
    "            roi = frame[y:y + h, x:x + w]\n",
    "            input_data = preprocess(roi)\n",
    "            prediction = model.predict(input_data)\n",
    "            predicted_class = np.argmax(prediction)\n",
    "            confidence = prediction[0][predicted_class]\n",
    "            current_label = f\"{class_labels[predicted_class]} ({confidence*100:.1f}%)\"\n",
    "            print(\"Prediction:\", current_label)\n",
    "            last_prediction_time = time.time()\n",
    "\n",
    "        # Label near bounding box\n",
    "        cv2.putText(display_frame, current_label, (x, y - 10),\n",
    "                    cv2.FONT_HERSHEY_SIMPLEX, 0.9, (255, 0, 0), 2)\n",
    "\n",
    "    # Show video\n",
    "    cv2.imshow(\"Real-time Arecanut Classifier\", display_frame)\n",
    "\n",
    "    if cv2.waitKey(1) & 0xFF == ord('q'):\n",
    "        break\n",
    "\n",
    "cap.release()\n",
    "cv2.destroyAllWindows()\n"
   ]
