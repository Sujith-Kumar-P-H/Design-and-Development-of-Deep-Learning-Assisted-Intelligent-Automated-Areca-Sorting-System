    "import numpy as np\n",
    "\n",
    "# Predict on test data\n",
    "predictions = model.predict(test_generator)\n",
    "\n",
    "# Convert probabilities to class indices (0 or 1)\n",
    "predicted_classes = np.argmax(predictions, axis=1)\n",
    "\n",
    "# Get class labels: ['ripe', 'unripe']\n",
    "class_names = list(train_generator.class_indices.keys())  # {'ripe': 0, 'unripe': 1}\n",
    "\n",
    "# Map predicted indices to labels\n",
    "predicted_labels = [class_names[i] for i in predicted_classes]\n",
    "\n",
    "# Print predicted labels for each test image\n",
    "for idx, label in enumerate(predicted_labels):\n",
    "    print(f\"Image {idx + 1}: Predicted - {label}\")\n"
