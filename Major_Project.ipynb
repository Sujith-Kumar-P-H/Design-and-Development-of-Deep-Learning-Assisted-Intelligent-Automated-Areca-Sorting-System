    "            ext = os.path.splitext(filename)[1]  # get file extension (.jpg, .png, etc.)\n",
    "            new_name = f\"{class_name}_{i+1:03d}{ext}\"\n",
    "            src = os.path.join(class_folder, filename)\n",
    "            dst = os.path.join(class_folder, new_name)\n",
    "            os.rename(src, dst)\n",
    "\n",
    "        print(f\"✓ Renamed {len(files)} files in '{class_name}'\")\n"
   ]
