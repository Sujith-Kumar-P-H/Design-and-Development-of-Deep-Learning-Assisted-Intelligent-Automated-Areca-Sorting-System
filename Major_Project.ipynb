    "import cv2\n",
    "import numpy as np\n",
    "from tensorflow.keras.models import load_model\n",
    "\n",
    "# Load the trained model\n",
    "model = load_model(\"Areca_image_classifier_v2.h5\")\n",
    "class_labels = ['unripe', 'ripe']\n",
    "\n",
    "# Preprocess image for model input\n",
    "def preprocess(img):\n",
    "    img = cv2.GaussianBlur(img, (5, 5), 0)  # Reduce noise\n",
    "    img = cv2.resize(img, (224, 224))\n",
    "    img = img / 255.0\n",
    "    img = np.expand_dims(img, axis=0)\n",
    "    return img\n",
    "\n",
    "# Start webcam\n",
    "cap = cv2.VideoCapture(0)\n",
    "\n",
    "while True:\n",
    "    ret, frame = cap.read()\n",
    "    if not ret:\n",
    "        break\n",
    "\n",
    "    frame = cv2.resize(frame, (640, 480))\n",
    "    output = frame.copy()\n",
    "\n",
    "    # Convert to HSV to detect both ripe and unripe\n",
    "    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)\n",
    "\n",
    "    # Unripe (green) and ripe (orange/yellow) ranges\n",
    "    lower_unripe = np.array([35, 40, 40])\n",
    "    upper_unripe = np.array([85, 255, 255])\n",
    "\n",
    "    lower_ripe = np.array([10, 60, 60])\n",
    "    upper_ripe = np.array([30, 255, 255])\n",
    "\n",
    "    # Create masks and combine\n",
    "    mask_unripe = cv2.inRange(hsv, lower_unripe, upper_unripe)\n",
    "    mask_ripe = cv2.inRange(hsv, lower_ripe, upper_ripe)\n",
    "    mask = cv2.bitwise_or(mask_unripe, mask_ripe)\n",
    "\n",
    "    # Optional: clean mask\n",
    "    kernel = np.ones((5, 5), np.uint8)\n",
    "    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)\n",
    "    mask = cv2.dilate(mask, kernel, iterations=1)\n",
    "\n",
    "    # Find contours\n",
    "    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n",
    "\n",
    "    for cnt in contours:\n",
    "        x, y, w, h = cv2.boundingRect(cnt)\n",
    "        if w > 50 and h > 50:\n",
    "            # Add margin to capture nut fully\n",
    "            margin = 10\n",
    "            x1, y1 = max(x - margin, 0), max(y - margin, 0)\n",
    "            x2, y2 = min(x + w + margin, frame.shape[1]), min(y + h + margin, frame.shape[0])\n",
    "            roi = frame[y1:y2, x1:x2]\n",
    "\n",
    "            try:\n",
    "                processed = preprocess(roi)\n",
    "                prediction = model.predict(processed, verbose=0)[0]\n",
    "                class_idx = np.argmax(prediction)\n",
    "                confidence = prediction[class_idx]\n",
    "                label = f\"{class_labels[class_idx]} ({confidence:.2f})\"\n",
    "                color = (0, 255, 0) if class_idx == 0 else (0, 0, 255)\n",
    "\n",
    "                # Draw result\n",
    "                cv2.rectangle(output, (x1, y1), (x2, y2), color, 2)\n",
    "                cv2.putText(output, label, (x1, y1 - 10),\n",
    "                            cv2.FONT_HERSHEY_SIMPLEX, 0.7, color, 2)\n",
    "\n",
    "            except Exception as e:\n",
    "                print(\"Error in prediction:\", e)\n",
    "\n",
    "    cv2.imshow(\"Real-Time Arecanut Detection\", output)\n",
    "\n",
    "    if cv2.waitKey(1) & 0xFF == ord('q'):\n",
    "        break\n",
    "\n",
    "cap.release()\n",
    "cv2.destroyAllWindows()\n"
   ]
