    "class_labels = ['Ripe', 'Unripe']  # Ensure this matches the training label order\n",
    "\n",
    "# Preprocessing function\n",
    "def preprocess(img):\n",
    "    img = cv2.resize(img, (224, 224))\n",
    "    img = img / 255.0  # Normalize pixel values\n",
    "    img = np.expand_dims(img, axis=0)  # Add batch dimension\n",
    "    return img\n",
    "\n",
    "# Start webcam capture\n",
    "cap = cv2.VideoCapture(0)\n",
    "\n",
    "while True:\n",
    "    ret, frame = cap.read()\n",
    "    if not ret:\n",
    "        break\n",
    "\n",
    "    # Resize for performance\n",
    "    frame = cv2.resize(frame, (640, 480))\n",
    "    output_frame = frame.copy()\n",
    "\n",
    "    # Convert to HSV color space for basic arecanut masking (optional, tweak for better accuracy)\n",
    "    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)\n",
    "    lower_bound = np.array([10, 60, 60])     # Adjust based on your lighting/arecanut color\n",
    "    upper_bound = np.array([35, 255, 255])\n",
    "    mask = cv2.inRange(hsv, lower_bound, upper_bound)\n",
    "\n",
    "    # Find contours in the mask\n",
    "    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n",
    "\n",
    "    for cnt in contours:\n",
    "        x, y, w, h = cv2.boundingRect(cnt)\n",
    "        if w > 50 and h > 50:  # Filter out small noise\n",
    "            roi = frame[y:y+h, x:x+w]\n",
    "            preprocessed = preprocess(roi)\n",
    "            prediction = model.predict(preprocessed, verbose=0)[0]\n",
    "\n",
    "            class_idx = np.argmax(prediction)\n",
    "            label = class_labels[class_idx]\n",
    "            confidence = prediction[class_idx]\n",
    "\n",
    "            color = (0, 255, 0) if label == 'Ripe' else (0, 0, 255)\n",
    "\n",
    "            # Draw bounding box and label with confidence\n",
    "            cv2.rectangle(output_frame, (x, y), (x + w, y + h), color, 2)\n",
    "            cv2.putText(output_frame, f\"{label} ({confidence:.2f})\", (x, y - 10),\n",
    "                        cv2.FONT_HERSHEY_SIMPLEX, 0.7, color, 2)\n",
    "\n",
