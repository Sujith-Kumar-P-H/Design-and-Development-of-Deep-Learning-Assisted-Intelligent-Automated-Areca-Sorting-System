    "import cv2\n",
    "import numpy as np\n",
    "from tensorflow.keras.models import load_model\n",
    "from tensorflow.keras.preprocessing.image import img_to_array\n",
    "\n",
    "# Load trained model\n",
    "model = load_model(\"Areca_image_classifier.h5\")\n",
    "print(\"Model Input Shape:\", model.input_shape)\n",
    "target_size = model.input_shape[1:3]\n",
    "\n",
    "# Class labels based on training\n",
    "class_labels = ['Ripe', 'Unripe']  # Ensure correct order\n",
    "\n",
    "def preprocess(image, target_size=target_size):\n",
    "    image = cv2.resize(image, target_size)\n",
    "    image = img_to_array(image)\n",
    "    image = image / 255.0\n",
    "    return np.expand_dims(image, axis=0)\n",
    "\n",
    "# --- Predict Function ---\n",
    "def classify_image(image_path):\n",
    "    image = cv2.imread(image_path)\n",
    "    if image is None:\n",
    "        print(f\"Failed to load image: {image_path}\")\n",
    "        return\n",
    "\n",
    "    # Optional: crop ROI if needed\n",
    "    # roi = image[100:300, 100:300]  # Adjust if you want to crop\n",
    "    roi = image\n",
    "\n",
    "    input_data = preprocess(roi)\n",
    "    prediction = model.predict(input_data, verbose=0)[0]\n",
    "    class_idx = np.argmax(prediction)\n",
    "    confidence = prediction[class_idx]\n",
    "    label = class_labels[class_idx]\n",
    "\n",
    "    print(f\"Image: {image_path}\")\n",
    "    print(f\"Prediction raw: {prediction}\")\n",
    "    print(f\"Predicted label: {label} (Confidence: {confidence:.2f})\\n\")\n",
    "\n",
    "# --- Test on ripe and unripe ---\n",
    "ripe_image = r\"C:\\Users\\sujit\\OneDrive\\Desktop\\Major Project files\\Main_Project\\dataset_split\\test\\ripe\\Ripe_202_nobg.png\"\n",
