    "import os\n",
    "import shutil\n",
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "# Input paths\n",
    "base_dir = r\"C:\\Users\\sujit\\OneDrive\\Desktop\\Major Project files\\Main_Project\\Processed_dataset\" # Folder with ripe/ and unripe/ subfolders\n",
    "output_dir = r\"C:\\Users\\sujit\\OneDrive\\Desktop\\Major Project files\\Main_Project\\dataset_split\"  # Output folder for train/test\n",
    "\n",
    "# Train-test split ratio\n",
    "train_ratio = 0.8\n",
    "\n",
    "# Classes\n",
    "classes = ['Ripe', 'Unripe']\n",
    "\n",
    "for cls in classes:\n",
    "    cls_folder = os.path.join(base_dir, cls)\n",
    "    images = [f for f in os.listdir(cls_folder) if f.lower().endswith(('.jpg', '.jpeg', '.png'))]\n",
    "\n",
    "    train_imgs, test_imgs = train_test_split(images, train_size=train_ratio, random_state=42)\n",
    "\n",
    "    for split_type, split_imgs in zip(['train', 'test'], [train_imgs, test_imgs]):\n",
    "        split_dir = os.path.join(output_dir, split_type, cls)\n",
    "        os.makedirs(split_dir, exist_ok=True)\n",
    "\n",
    "        for img in split_imgs:\n",
    "            src = os.path.join(cls_folder, img)\n",
    "            dst = os.path.join(split_dir, img)\n",
    "            shutil.copy2(src, dst)\n",
    "\n",
    "print(\"✅ Data split complete! Check 'dataset_split/train/' and 'dataset_split/test/'\")\n"
   ]
  },
