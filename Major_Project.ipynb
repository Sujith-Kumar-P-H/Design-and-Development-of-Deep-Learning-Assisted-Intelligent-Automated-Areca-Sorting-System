    "import cv2\n",
    "import numpy as np\n",
    "from tensorflow.keras.models import load_model\n",
    "\n",
    "# Load the trained classification model\n",
    "model = load_model(\"Areca_image_classifier.h5\")  # Update path if needed\n",
    "class_labels = ['Ripe', 'Unripe']\n",
    "\n",
    "# Preprocessing function\n",
    "def preprocess(img):\n",
    "    img = cv2.resize(img, (224, 224))\n",
    "    img = img / 255.0  # Normalize\n",
    "    img = np.expand_dims(img, axis=0)\n",
    "    return img\n",
    "\n",
    "# Start webcam capture m               \n",
    "cap = cv2.VideoCapture(0)\n",
    "\n",
    "while True:\n",
    "    ret, frame = cap.read()\n",
    "    if not ret:\n",
    "        break\n",
    "\n",
    "    # Optional: Resize for performance\n",
    "    frame = cv2.resize(frame, (640, 480))\n",
    "    output_frame = frame.copy()\n",
    "\n",
    "    # Convert to HSV to isolate orange/green arecanuts if background is plain\n",
    "    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)\n",
    "    lower_bound = np.array([10, 60, 60])\n",
    "    upper_bound = np.array([35, 255, 255])\n",
    "    mask = cv2.inRange(hsv, lower_bound, upper_bound)\n",
    "\n",
    "    # Find contours in the masked frame\n",
    "    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n",
    "\n",
    "    for cnt in contours:\n",
    "        x, y, w, h = cv2.boundingRect(cnt)\n",
    "        if w > 50 and h > 50:  # Filter small noise\n",
    "            roi = frame[y:y+h, x:x+w]\n",
    "            preprocessed = preprocess(roi)\n",
    "            prediction = model.predict(preprocessed)[0]\n",
    "            class_idx = np.argmax(prediction)\n",
    "            label = class_labels[class_idx]\n",
    "            color = (0, 255, 0) if label == 'Ripe' else (0, 0, 255)\n",
    "\n",
    "            # Draw bounding box and label\n",
    "            cv2.rectangle(output_frame, (x, y), (x+w, y+h), color, 2)\n",
    "            cv2.putText(output_frame, label, (x, y-10), cv2.FONT_HERSHEY_SIMPLEX, 0.8, color, 2)\n",
    "\n",
    "    # Show the annotated output\n",
    "    cv2.imshow(\"Arecanut Classification\", output_frame)\n",
    "\n",
    "    if cv2.waitKey(1) & 0xFF == ord('q'):\n",
    "        break\n",
    "\n",
    "cap.release()\n",
    "cv2.destroyAllWindows()\n"
   ]
